<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ipln_reconcile_rule_cents_list" model="ir.ui.view">
        <field name="name">ipln.reconcile.rule.cents.list</field>
        <field name="model">ipln.reconcile.rule.cents</field>
        <field name="arch" type="xml">
            <list string="Reconciliation Rules by Cents" decoration-muted="not active">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="cents" />
                <field name="counterpart_account_id" />
                <field name="maximum_amount" optional="show" />
                <field name="analytic_distribution" widget="analytic_distribution" optional="hide" />
                <field name="analytic_tag_ids" widget="many2many_tags" optional="hide" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_ipln_reconcile_rule_cents_form" model="ir.ui.view">
        <field name="name">ipln.reconcile.rule.cents.form</field>
        <field name="model">ipln.reconcile.rule.cents</field>
        <field name="arch" type="xml">
            <form string="Reconciliation Rule by Cents">
                <header>
                    <button name="link" string="Synchronize" type="object" class="btn-primary" />
                </header>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_reconcile_model"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-random"
                            invisible="not reconcile_model_id"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Reconciliation Model</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="sequence" />
                            <field name="cents" placeholder="Empty matches every cent value" />
                            <field name="maximum_amount" />
                        </group>
                        <group>
                            <field name="counterpart_account_id" />
                            <field name="counterpart_account_code" />
                            <field name="reconcile_model_id" readonly="1" />
                        </group>
                    </group>
                    <group string="Analytic Accounting">
                        <field
                            name="analytic_distribution"
                            widget="analytic_distribution"
                            options="{'account_field': 'counterpart_account_id', 'business_domain': 'general'}"
                        />
                        <field name="analytic_tag_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ipln_reconcile_rule_cents_search" model="ir.ui.view">
        <field name="name">ipln.reconcile.rule.cents.search</field>
        <field name="model">ipln.reconcile.rule.cents</field>
        <field name="arch" type="xml">
            <search string="Reconciliation Rules by Cents">
                <field name="name" />
                <field name="counterpart_account_id" />
                <field name="counterpart_account_code" />
                <filter name="catch_all" string="Catch-all" domain="[('cents', '=', False)]" />
                <separator />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter name="company" string="Company" context="{'group_by': 'company_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_account_reconcile_model_form" model="ir.ui.view">
        <field name="name">account.reconcile.model.form.cents.source</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form" />
        <field name="arch" type="xml">
            <field name="rule_type" position="after">
                <field
                    name="source_cents_rule_id"
                    readonly="1"
                    invisible="not source_cents_rule_id"
                />
            </field>
        </field>
    </record>

    <record id="action_ipln_reconcile_rule_cents" model="ir.actions.act_window">
        <field name="name">Reconciliation Rules by Cents</field>
        <field name="res_model">ipln.reconcile.rule.cents</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ipln_reconcile_rule_cents_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a reconciliation rule by cents</p>
            <p>The rule generates and maintains a standard reconciliation model.</p>
        </field>
    </record>

    <menuitem
        id="menu_ipln_reconcile_rule_cents"
        name="Rules by Cents"
        parent="account.account_banks_menu"
        action="action_ipln_reconcile_rule_cents"
        sequence="4"
        groups="account.group_account_manager"
    />
</odoo>

